# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── App ─────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO

# ── PostgreSQL (compose maps container 5432 -> host 5433) ────
# Use 127.0.0.1, not localhost: see docs/decisions.md ADR-005 (IPv6 stall on Windows).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=enterprise_ai
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_only
# Seconds per resolved address before libpq gives up. Never leave this unset:
# without it an unreachable database hangs instead of erroring (ADR-005).
POSTGRES_CONNECT_TIMEOUT=5

# ── LLM — đã chốt ở docs/decisions.md ADR-002 ───────────────
LLM_PROVIDER=google
# Pin phiên bản cụ thể, không dùng alias "-latest" (alias đổi model dưới chân bạn).
LLM_MODEL=gemini-3.1-flash-lite
# Lấy key ở Google AI Studio. KHÔNG điền key thật vào file này — file này được commit.
LLM_API_KEY=
# Gemini 3.x tính thinking token vào max output. Đặt thấp thì response rỗng.
LLM_MAX_OUTPUT_TOKENS=1200

# ── Embedding — đã chốt ở ADR-002 ──────────────────────────
EMBEDDING_BACKEND=api
EMBEDDING_MODEL=gemini-embedding-001
# 384 = outputDimensionality truncation (chiều gốc 3072), để khớp cột vector(384).
EMBEDDING_DIM=384

# ── Retrieval defaults ──────────────────────────────────────
RETRIEVAL_TOP_K=5
RRF_K=60
