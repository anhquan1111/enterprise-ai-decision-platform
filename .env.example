# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── App ─────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO

# ── PostgreSQL (compose maps container 5432 -> host 5433) ────
# Use 127.0.0.1, not localhost: see docs/decisions.md ADR-005 (IPv6 stall on Windows).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=enterprise_ai
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_only
# Seconds per resolved address before libpq gives up. Never leave this unset:
# without it an unreachable database hangs instead of erroring (ADR-005).
POSTGRES_CONNECT_TIMEOUT=5

# ── LLM provider — decided on D2, see docs/decisions.md ─────
# LLM_PROVIDER: anthropic | openai | google
LLM_PROVIDER=unset
LLM_MODEL=unset
LLM_API_KEY=

# ── Embeddings — decided on D2 ──────────────────────────────
# EMBEDDING_BACKEND: local | api
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Retrieval defaults ──────────────────────────────────────
RETRIEVAL_TOP_K=5
RRF_K=60
