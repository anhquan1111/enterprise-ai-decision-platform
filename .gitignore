data/raw/
data/processed/
*.parquet

# ── MLflow (eval run tracking) ──────────────────────────────
mlruns/
mlflow.db

# ── Local model cache (embeddings / reranker) ───────────────
models/
.cache/

# ── OS / editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# NOTE: eval/ and evidence/ ARE committed on purpose.
